      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full bg-brand-sage/60 rounded-3xl p-10 text-center border border-brand-sageBorder">
            <div class="w-14 h-14 rounded-2xl bg-white text-brand-fresh flex items-center justify-center mx-auto mb-3 border border-brand-sageBorder">
              <i class="fa-solid fa-magnifying-glass text-xl"></i>
            </div>
            <h3 class="font-display font-bold text-lg text-brand-dark">Produk Tidak Ditemukan</h3>
            <p class="text-xs sm:text-sm text-gray-600 mt-1">Tidak ada produk yang cocok dengan kata kunci "<strong>${searchQuery}</strong>".</p>
            <button type="button" onclick="clearSearch(); setCategory('all');" class="mt-4 bg-brand-dark text-white text-xs font-bold px-4 py-2.5 rounded-xl">
              Tampilkan Semua Produk
            </button>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(product => {
        const inCartItem = cart.find(item => item.productId === product.id);
        const qtyInCart = inCartItem ? inCartItem.qty : 0;

        return `
          <div class="group bg-white rounded-2xl border border-brand-sageBorder hover:border-brand-fresh shadow-xs hover:shadow-xl hover:shadow-brand-dark/5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
            <div>
              <!-- Foto Kemasan Individual (Potongan 12_2.jpg / Fallback SVG Kemasan SSS) -->
              <div class="relative bg-gradient-to-b from-brand-sage/90 via-white to-brand-sage/40 h-56 overflow-hidden flex items-center justify-center border-b border-brand-sageBorder/60">
                ${renderProductVisual(product, 'w-full h-full object-contain pt-8 pb-2 px-4 group-hover:scale-105 transition-transform duration-500 drop-shadow-sm', 'w-36 h-36')}
                <span class="absolute top-3 left-3 text-[11px] font-bold px-2.5 py-1 rounded-full bg-white/95 backdrop-blur-xs text-brand-forest border border-brand-sageBorder shadow-2xs">
                  ${product.packaging}
                </span>
                <span class="absolute top-3 right-3 text-[11px] font-bold px-2.5 py-1 rounded-full bg-brand-dark/90 backdrop-blur-xs text-white shadow-2xs">
                  ${product.badge}
                </span>
              </div>

              <!-- Detail Informasi Produk -->
              <div class="p-5 pb-3">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-fresh">${product.categoryLabel}</span>
                <h3 class="font-display font-bold text-lg text-brand-dark mt-0.5 group-hover:text-brand-fresh transition-colors">
                  ${product.name}
                </h3>
                <p class="text-xs text-gray-600 mt-2 leading-relaxed">
                  ${product.description}
                </p>
              </div>
            </div>

            <!-- Harga Resmi per pcs & Tombol Keranjang -->
            <div class="px-5 pb-5 pt-2">
              <div class="bg-brand-sage/75 rounded-xl p-3 mb-3 flex items-baseline justify-between">
                <div>
                  <span class="block text-[10px] font-semibold uppercase text-gray-500">Harga Resmi</span>
                  <span class="font-display font-extrabold text-xl text-brand-dark">${formatRupiah(product.price)}</span>
                  <span class="text-xs text-gray-500 font-medium">${product.unitLabel}</span>
                </div>
                ${qtyInCart > 0 ? `<span class="text-[11px] font-bold text-brand-forest bg-white px-2.5 py-0.5 rounded-full border border-brand-sageBorder">${qtyInCart} pcs</span>` : ''}
              </div>

              ${qtyInCart > 0 ? `
                <div class="flex items-center justify-between gap-2 bg-brand-sage rounded-xl p-1.5 border border-brand-sageBorder">
                  <button type="button" onclick="updateCartQty('${product.id}', -1)" aria-label="Kurangi jumlah" class="w-9 h-9 rounded-lg bg-white hover:bg-gray-100 text-brand-dark font-extrabold text-sm flex items-center justify-center shadow-2xs transition-colors">
                    <i class="fa-solid fa-minus text-xs"></i>
                  </button>
                  <span class="font-display font-bold text-sm text-brand-dark">${qtyInCart} pcs di keranjang</span>
                  <button type="button" onclick="updateCartQty('${product.id}', 1)" aria-label="Tambah jumlah" class="w-9 h-9 rounded-lg bg-brand-dark hover:bg-brand-forest text-white font-extrabold text-sm flex items-center justify-center shadow-2xs transition-colors">
                    <i class="fa-solid fa-plus text-xs"></i>
                  </button>
                </div>
              ` : `
                <button type="button" onclick="addToCart('${product.id}')" class="w-full bg-brand-dark hover:bg-brand-forest active:scale-[0.99] text-white font-semibold text-sm py-3 px-4 rounded-xl shadow-2xs transition-all flex items-center justify-center gap-2">
                  <i class="fa-solid fa-plus text-xs"></i>
                  <span>Tambah ke Keranjang</span>
                </button>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    // Render Tabel Daftar Harga Resmi (5 Kolom)
    function renderPriceTable() {
      const tbody = document.getElementById('price-table-body');
      tbody.innerHTML = PRODUCTS.map((p, index) => {
        const rowBg = index % 2 === 0 ? 'bg-white' : 'bg-brand-sage/30';
        return `
          <tr class="${rowBg} hover:bg-brand-sage/70 transition-colors">
            <td class="py-4 px-6">
              <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-xl overflow-hidden bg-white border border-brand-sageBorder shrink-0 flex items-center justify-center">
                  ${renderProductVisual(p, 'w-full h-full object-contain p-1', 'w-11 h-11')}
                </div>
                <div>
                  <div class="font-display font-bold text-brand-dark">${p.name}</div>
                  <div class="text-xs text-gray-500 mt-0.5 max-w-sm">${p.description}</div>
                </div>
              </div>
            </td>
            <td class="py-4 px-6 whitespace-nowrap">
              <span class="inline-block text-xs font-semibold text-brand-forest bg-brand-sage px-2.5 py-1 rounded-full border border-brand-sageBorder">
                ${p.categoryLabel}
              </span>
            </td>
            <td class="py-4 px-6 text-xs font-semibold text-gray-600 whitespace-nowrap">
              ${p.packaging}
            </td>
            <td class="py-4 px-6 text-right font-display font-extrabold text-base text-brand-dark bg-brand-sage/50 whitespace-nowrap">
              ${formatRupiah(p.price)} <span class="text-xs font-medium text-gray-500">${p.unitLabel}</span>
            </td>
            <td class="py-4 px-6 text-center whitespace-nowrap">
              <button
                type="button"
                onclick="addToCart('${p.id}')"
                class="inline-flex items-center gap-1.5 bg-brand-dark hover:bg-brand-forest text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-2xs transition-colors"
              >
                <i class="fa-solid fa-plus text-[10px]"></i>
                <span>Pesan</span>
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Tambah Item ke Keranjang
    function addToCart(productId) {
      const existing = cart.find(item => item.productId === productId);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ productId, qty: 1 });
      }
      const product = PRODUCTS.find(p => p.id === productId);
      renderProducts();
      renderCart();
      showToast(`${product.name} ditambahkan ke keranjang!`);
    }

    // Ubah Kuantitas Item di Keranjang
    function updateCartQty(productId, delta) {
      const idx = cart.findIndex(item => item.productId === productId);
      if (idx === -1) return;

      cart[idx].qty += delta;
      if (cart[idx].qty <= 0) {
        cart.splice(idx, 1);
      }
      renderProducts();
      renderCart();
    }

    // Render Isi Keranjang Slide-Over
    function renderCart() {
      const container = document.getElementById('cart-items-container');
      const badge = document.getElementById('cart-badge');
      const totalEl = document.getElementById('cart-total-price');

      const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
      badge.textContent = totalItems;

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="h-full flex flex-col items-center justify-center text-center py-12">
            <div class="w-16 h-16 rounded-2xl bg-brand-sage text-brand-fresh flex items-center justify-center mb-4">
              <i class="fa-solid fa-basket-shopping text-2xl"></i>
            </div>
            <h4 class="font-display font-bold text-gray-800">Keranjang Masih Kosong</h4>
            <p class="text-xs text-gray-500 mt-1 max-w-xs">Pilih sayuran segar premium atau paket siap masak SSS dari katalog untuk mulai memesan.</p>
            <button onclick="toggleCart(false)" class="mt-5 text-xs font-bold text-brand-dark bg-brand-sage hover:bg-brand-sageBorder px-4 py-2.5 rounded-xl transition-colors">
              Lihat Katalog Produk
            </button>
          </div>
        `;
        totalEl.textContent = 'Rp 0';
        return;
      }

      let grandTotal = 0;

      container.innerHTML = cart.map(item => {
        const product = PRODUCTS.find(p => p.id === item.productId);
        const unitPrice = product.price;
        const subtotal = unitPrice * item.qty;
        grandTotal += subtotal;

        return `
          <div class="bg-brand-sage/60 rounded-2xl p-3.5 border border-brand-sageBorder flex items-center gap-3">
            <div class="w-14 h-14 rounded-xl overflow-hidden bg-white border border-brand-sageBorder shrink-0 flex items-center justify-center">
              ${renderProductVisual(product, 'w-full h-full object-contain p-1', 'w-11 h-11')}
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2">
                <h4 class="font-display font-bold text-sm text-brand-dark truncate">${product.name}</h4>
                <button onclick="updateCartQty('${product.id}', -${item.qty})" aria-label="Hapus item" class="text-gray-400 hover:text-red-500 text-xs shrink-0">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </div>
              <p class="text-[11px] text-gray-500">${product.packaging} · ${formatRupiah(unitPrice)} ${product.unitLabel}</p>

              <div class="mt-2 flex items-center justify-between gap-2">
                <div class="inline-flex items-center bg-white rounded-lg border border-gray-200 p-0.5">
                  <button onclick="updateCartQty('${product.id}', -1)" class="w-6 h-6 rounded-md hover:bg-gray-100 text-gray-700 font-bold text-xs flex items-center justify-center">-</button>
                  <span class="px-2.5 text-xs font-bold text-brand-dark">${item.qty} pcs</span>
                  <button onclick="updateCartQty('${product.id}', 1)" class="w-6 h-6 rounded-md hover:bg-gray-100 text-gray-700 font-bold text-xs flex items-center justify-center">+</button>
                </div>
                <span class="font-display font-bold text-sm text-brand-dark">${formatRupiah(subtotal)}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');

      totalEl.textContent = formatRupiah(grandTotal);
    }

    // Buka / Tutup Drawer Keranjang
    function toggleCart(open) {
      const overlay = document.getElementById('cart-overlay');
      const drawer = document.getElementById('cart-drawer');

      if (open) {
        overlay.classList.remove('hidden');
        requestAnimationFrame(() => {
          drawer.classList.remove('translate-x-full');
        });
      } else {
        drawer.classList.add('translate-x-full');
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 300);
      }
    }

    // Checkout ke WhatsApp
    function checkoutWhatsApp() {
      if (cart.length === 0) {
        showToast('Keranjang belanja Anda masih kosong!', 'warning');
        return;
      }

      const name = document.getElementById('cust-name').value.trim();
      const address = document.getElementById('cust-address').value.trim();
      const note = document.getElementById('cust-note').value.trim();

      if (!name || !address) {
        showToast('Mohon lengkapi Nama Pemesan dan Alamat Pengiriman.', 'warning');
        return;
      }

      let grandTotal = 0;
      const itemLines = cart.map((item, idx) => {
        const p = PRODUCTS.find(prod => prod.id === item.productId);
        const sub = p.price * item.qty;
        grandTotal += sub;
        return `${idx + 1}. ${p.name} (${p.packaging}) — ${item.qty} pcs = ${formatRupiah(sub)}`;
      }).join('\n');

      const message = `Halo Admin *PT Sayur Seger Sejahtera (SSS)*, saya ingin melakukan pemesanan:\n\n` +
        `*Nama Pemesan:* ${name}\n` +
        `*Alamat Kirim:* ${address}\n` +
        (note ? `*Catatan:* ${note}\n` : '') +
        `\n*Rincian Pesanan:*\n${itemLines}\n\n` +
        `*Estimasi Total:* ${formatRupiah(grandTotal)}\n\n` +
        `Mohon konfirmasi ketersediaan dan jadwal pengirimannya. Terima kasih!`;

      const waUrl = `https://wa.me/${ADMIN_WA_NUMBER}?text=${encodeURIComponent(message)}`;

      document.getElementById('wa-preview-text').value = message;
      document.getElementById('wa-direct-link').href = waUrl;
      toggleCart(false);
      document.getElementById('wa-preview-modal').classList.remove('hidden');
      document.getElementById('wa-preview-modal').classList.add('flex');
    }

    function closeWaPreview() {
      const modal = document.getElementById('wa-preview-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function copyWaText() {
      const textarea = document.getElementById('wa-preview-text');
      textarea.select();
      textarea.setSelectionRange(0, 99999);
      try {
        document.execCommand('copy');
        showToast('Teks pesanan berhasil disalin ke clipboard!');
      } catch (err) {
        showToast('Gagal menyalin teks, silakan salin manual.', 'warning');
      }
    }

    // Modal Kemitraan B2B
    function openPartnershipModal(defaultSegment = '') {
      const modal = document.getElementById('partnership-modal');
      if (defaultSegment) {
        const select = document.getElementById('b2b-segment');
        if (select) select.value = defaultSegment;
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closePartnershipModal() {
      const modal = document.getElementById('partnership-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function submitPartnershipForm(e) {
      e.preventDefault();
      const company = document.getElementById('b2b-company').value.trim();
      const pic = document.getElementById('b2b-pic').value.trim();
      const segment = document.getElementById('b2b-segment').value;
      const area = document.getElementById('b2b-area').value;
      const volume = document.getElementById('b2b-volume').value.trim() || '-';
      const notes = document.getElementById('b2b-notes').value.trim() || '-';

      const message = `Halo Tim Kemitraan *PT Sayur Seger Sejahtera (SSS)*,\n\n` +
        `Kami ingin mengajukan kerja sama / kontrak pasokan rutin dengan detail berikut:\n` +
        `• *Perusahaan/Usaha:* ${company}\n` +
        `• *PIC:* ${pic}\n` +
        `• *Segmen:* ${segment}\n` +
        `• *Wilayah:* ${area}\n` +
        `• *Estimasi Kebutuhan:* ${volume}\n` +
        `• *Komoditas Diminati:* ${notes}\n\n` +
        `Mohon informasi lebih lanjut mengenai penawaran kerja sama B2B. Terima kasih.`;

      const waUrl = `https://wa.me/${ADMIN_WA_NUMBER}?text=${encodeURIComponent(message)}`;
      closePartnershipModal();

      document.getElementById('wa-preview-text').value = message;
      document.getElementById('wa-direct-link').href = waUrl;
      document.getElementById('wa-preview-modal').classList.remove('hidden');
      document.getElementById('wa-preview-modal').classList.add('flex');
    }

    // Toggle Menu Mobile
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const icon = document.getElementById('mobile-menu-icon');
      menu.classList.toggle('hidden');
      if (menu.classList.contains('hidden')) {
        icon.classList.remove('fa-xmark');
        icon.classList.add('fa-bars');
      } else {
        icon.classList.remove('fa-bars');
        icon.classList.add('fa-xmark');
      }
    }

    // Toast Notification Non-Blocking
    function showToast(text, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const bgClass = type === 'warning' ? 'bg-amber-600' : 'bg-brand-dark';
      const iconClass = type === 'warning' ? 'fa-circle-exclamation' : 'fa-circle-check';

      toast.className = `${bgClass} text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-lg flex items-center gap-2.5 transform transition-all duration-300 translate-y-2 opacity-0`;
      toast.innerHTML = `<i class="fa-solid ${iconClass} text-brand-lime"></i><span>${text}</span>`;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 2800);
    }

    // Inisialisasi saat halaman dimuat
    window.addEventListener('DOMContentLoaded', () => {
      renderProducts();
      renderPriceTable();
      renderCart();
      sliceProductImagesFromSource(DISPLAY_IMAGE_SRC, false);
    });
  </script>
</body>
</html>
