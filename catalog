    /**
     * Memotong (crop) setiap kemasan individual dari sumber gambar (file lokal 12_2.jpg
     * atau file yang dipilih pengguna) menggunakan HTML5 Canvas.
     */
    function sliceProductImagesFromSource(imageSrc, isManualUpload = false) {
      const img = new Image();
      img.onload = function () {
        const natW = img.naturalWidth;
        const natH = img.naturalHeight;
        if (!natW || !natH) return;

        let successCount = 0;

        PRODUCTS.forEach(product => {
          try {
            const sx = Math.round(product.crop.x * natW);
            const sy = Math.round(product.crop.y * natH);
            const sw = Math.round(product.crop.w * natW);
            const sh = Math.round(product.crop.h * natH);

            const canvas = document.createElement('canvas');
            canvas.width = sw;
            canvas.height = sh;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, sx, sy, sw, sh, 0, 0, sw, sh);

            croppedProductImages[product.id] = canvas.toDataURL('image/jpeg', 0.94);
            successCount++;
          } catch (err) {
            console.warn('Gagal memotong kemasan produk:', product.id, err);
          }
        });

        if (successCount > 0) {
          const badge = document.getElementById('crop-status-badge');
          if (badge) {
            badge.innerHTML = `<i class="fa-solid fa-circle-check text-brand-fresh"></i><span>Foto Kemasan <strong>12_2.jpg</strong> Terpasang (${successCount}/7)</span>`;
          }
          renderProducts();
          renderPriceTable();
          renderCart();
          if (isManualUpload) {
            showToast('7 foto kemasan produk berhasil dipotong dan dipasang ke katalog!');
          }
        }
      };

      img.onerror = function () {
        const badge = document.getElementById('crop-status-badge');
        if (badge) {
          badge.innerHTML = `<i class="fa-solid fa-leaf text-brand-fresh"></i><span>Ilustrasi Kemasan SSS Aktif (Klik tombol di kanan untuk muat foto asli)</span>`;
        }
      };

      img.src = imageSrc;
    }

    // Handler unggah manual gambar 12_2.jpg jika sandbox memblokir pembacaan file lokal
    function handleManualDisplayUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function (e) {
        if (e.target && e.target.result) {
          sliceProductImagesFromSource(e.target.result, true);
        }
      };
      reader.readAsDataURL(file);
    }

    // Handler unggah manual gambar latar pembuka cover.jpg
    function handleManualCoverUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function (e) {
        const coverImg = document.getElementById('hero-cover-img');
        if (coverImg && e.target && e.target.result) {
          coverImg.src = e.target.result;
          coverImg.style.display = 'block';
          showToast('Latar pembuka cover berhasil diperbarui!');
        }
      };
      reader.readAsDataURL(file);
    }

