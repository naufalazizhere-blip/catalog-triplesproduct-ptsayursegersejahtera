<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PT Sayur Seger Sejahtera (SSS) — Fresh, Fast and Premium</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  
  <!-- Font Awesome untuk Ikon -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              dark: '#1B5E20',
              forest: '#2E5A27',
              fresh: '#689F38',
              lime: '#8BC34A',
              sage: '#F3F6F1',
              sageBorder: '#DCE5D7',
              gold: '#F59E0B',
            }
          }
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F3F6F1;
    }
    ::-webkit-scrollbar-thumb {
      background: #A5C496;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #689F38;
    }
    .hero-grid-bg {
      background-image: radial-gradient(rgba(104, 159, 56, 0.14) 1.25px, transparent 1.25px);
      background-size: 26px 26px;
    }
  </style>
</head>
<body class="bg-white text-gray-800 font-sans antialiased selection:bg-brand-lime/30 selection:text-brand-dark">

  <!-- ==================== 1. NAVBAR ==================== -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-sageBorder transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Brand Logo PT Sayur Seger Sejahtera -->
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-11 h-11 rounded-2xl bg-brand-sage border border-brand-sageBorder flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform">
            <svg viewBox="0 0 64 64" class="w-8 h-8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="18" r="9" fill="#F59E0B"/>
              <path d="M32 48C32 48 12 42 12 24C24 24 32 34 32 48Z" fill="#2E5A27"/>
              <path d="M32 48C32 48 52 42 52 24C40 24 32 34 32 48Z" fill="#689F38"/>
              <path d="M32 52C32 52 18 48 16 36C25 36 32 43 32 52Z" fill="#8BC34A"/>
              <path d="M32 52C32 52 46 48 48 36C39 36 32 43 32 52Z" fill="#1B5E20"/>
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block text-[11px] font-bold tracking-widest uppercase text-brand-fresh">PT Sayur Seger</span>
            <span class="block font-display font-extrabold text-lg sm:text-xl text-brand-dark tracking-tight">
              Sejahtera <span class="text-xs font-bold bg-brand-sage text-brand-forest px-2 py-0.5 rounded-full border border-brand-sageBorder ml-0.5">SSS</span>
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-gray-600">
          <a href="#produk" class="hover:text-brand-dark transition-colors">Produk Kami</a>
          <a href="#keunggulan" class="hover:text-brand-dark transition-colors">Keunggulan</a>
          <a href="#kemitraan" class="hover:text-brand-dark transition-colors">Kemitraan B2B</a>
          <a href="#daftar-harga" class="hover:text-brand-dark transition-colors">Daftar Harga</a>
          <a href="#kontak" class="hover:text-brand-dark transition-colors">Kontak</a>
        </nav>

        <!-- Action Buttons (Cart & Mobile Menu) -->
        <div class="flex items-center gap-2.5">
          <button
            type="button"
            onclick="toggleCart(true)"
            class="relative inline-flex items-center gap-2 bg-brand-dark hover:bg-brand-forest text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow-xs transition-all"
          >
            <i class="fa-solid fa-basket-shopping text-brand-lime"></i>
            <span class="hidden sm:inline">Keranjang</span>
            <span id="cart-badge" class="bg-brand-fresh text-white text-[11px] font-bold px-2 py-0.5 rounded-full">0</span>
          </button>

          <button
            type="button"
            onclick="toggleMobileMenu()"
            aria-label="Buka Menu"
            class="md:hidden w-10 h-10 rounded-xl bg-brand-sage border border-brand-sageBorder text-brand-dark flex items-center justify-center"
          >
            <i id="mobile-menu-icon" class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-brand-sageBorder px-4 py-4 space-y-2.5">
      <a href="#produk" onclick="toggleMobileMenu()" class="block py-2 text-sm font-semibold text-gray-700 hover:text-brand-dark">Produk Kami</a>
      <a href="#keunggulan" onclick="toggleMobileMenu()" class="block py-2 text-sm font-semibold text-gray-700 hover:text-brand-dark">Keunggulan</a>
      <a href="#kemitraan" onclick="toggleMobileMenu()" class="block py-2 text-sm font-semibold text-gray-700 hover:text-brand-dark">Kemitraan B2B</a>
      <a href="#daftar-harga" onclick="toggleMobileMenu()" class="block py-2 text-sm font-semibold text-gray-700 hover:text-brand-dark">Daftar Harga</a>
      <a href="#kontak" onclick="toggleMobileMenu()" class="block py-2 text-sm font-semibold text-gray-700 hover:text-brand-dark">Kontak</a>
    </div>
  </header>

  <!-- ==================== 2. HERO SECTION (LATAR PEMBUKA COVER.JPG) ==================== -->
  <section class="relative overflow-hidden bg-brand-sage pt-12 pb-16 lg:pt-20 lg:pb-24">
    <!-- Latar Belakang Full-Bleed cover.jpg + Fallback Pemandangan Kebun Pegunungan -->
    <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden">
      <!-- Fallback SVG Pegunungan & Lahan Sayur jika cover.jpg tidak terbaca -->
      <svg viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" class="w-full h-full object-cover opacity-50" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="skyMist" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FEFCE8"/>
            <stop offset="55%" stop-color="#F3F6F1"/>
            <stop offset="100%" stop-color="#DCE5D7"/>
          </linearGradient>
        </defs>
        <rect width="1440" height="720" fill="url(#skyMist)"/>
        <circle cx="620" cy="180" r="110" fill="#FDE68A" opacity="0.55"/>
        <path d="M0 430 L320 260 L640 390 L1020 170 L1440 380 L1440 720 L0 720 Z" fill="#C5D8BE" opacity="0.5"/>
        <path d="M0 500 Q480 430 960 490 T1440 460 L1440 720 L0 720 Z" fill="#A3C495" opacity="0.45"/>
        <path d="M0 570 Q520 520 1040 580 T1440 550 L1440 720 L0 720 Z" fill="#8BC34A" opacity="0.3"/>
      </svg>

      <!-- Gambar Latar Resmi cover.jpg -->
      <img
        id="hero-cover-img"
        src="cover.jpg"
        alt="Latar Kebun Sayur Pegunungan PT Sayur Seger Sejahtera"
        onerror="this.style.display='none';"
        class="absolute inset-0 w-full h-full object-cover object-center opacity-45 scale-[1.01]"
      />

      <!-- Overlay Gradien Putih/Sage Semi-Transparan agar Teks & Logo Tetap Tajam -->
      <div class="absolute inset-0 bg-gradient-to-b from-white/85 via-white/75 to-white"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.72)_0%,rgba(243,246,241,0.38)_65%,rgba(255,255,255,0.88)_100%)]"></div>
    </div>

    <!-- Tombol Kecil Muat / Ganti Latar Cover di Pojok Kanan Atas Hero -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 flex justify-end mb-4 sm:mb-0">
      <input type="file" id="manual-cover-input" accept="image/*" class="hidden" onchange="handleManualCoverUpload(event)" />
      <button
        type="button"
        onclick="document.getElementById('manual-cover-input').click()"
        class="inline-flex items-center gap-1.5 bg-white/85 hover:bg-white backdrop-blur-md text-brand-forest border border-brand-sageBorder text-[11px] font-semibold px-3 py-1.5 rounded-full shadow-2xs transition-all"
        title="Pilih file cover.jpg jika pratinjau browser belum memuat latar lokal"
      >
        <i class="fa-regular fa-image text-brand-fresh"></i>
        <span>Muat / Ganti Cover</span>
      </button>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        
        <div class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-white/95 backdrop-blur-xs border border-brand-sageBorder shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-fresh animate-pulse"></span>
          <span class="text-xs font-bold text-brand-forest tracking-wide">PT Sayur Seger Sejahtera (SSS) · Fresh, Fast and Premium</span>
        </div>

        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-[56px] text-brand-dark leading-[1.12] tracking-tight drop-shadow-[0_1px_1px_rgba(255,255,255,0.9)]">
          Segar Alaminya, <span class="text-brand-fresh">Sehat Keluarganya</span>
        </h1>

        <p class="font-display font-semibold text-lg sm:text-xl text-gray-800">
          Sayuran segar, sehat, dan siap untuk kebutuhan harian Anda.
        </p>

        <p class="text-gray-700 leading-relaxed text-sm sm:text-base max-w-2xl mx-auto bg-white/60 backdrop-blur-xs rounded-2xl px-4 py-2.5 border border-white/80">
          Mitra terpercaya penyedia sayuran segar pilihan dan paket siap masak higienis dengan standar rantai dingin (<em>cold chain</em>) — melayani kebutuhan dapur keluarga (B2C) hingga pasokan terjadwal skala bisnis (B2B) di wilayah <strong>Bandung Raya & Jabodetabek</strong>.
        </p>

        <!-- Tombol CTA Utama -->
        <div class="flex flex-wrap items-center justify-center gap-3.5 pt-2">
          <a href="#produk" class="inline-flex items-center justify-center gap-2.5 bg-brand-dark hover:bg-brand-forest text-white font-bold text-sm sm:text-base px-7 py-4 rounded-2xl shadow-lg shadow-brand-dark/20 transition-all">
            <i class="fa-solid fa-basket-shopping"></i>
            <span>Lihat Katalog & Pesan</span>
          </a>
          <button onclick="openPartnershipModal()" class="inline-flex items-center justify-center gap-2.5 bg-white/95 hover:bg-brand-sage text-brand-dark border border-brand-sageBorder font-bold text-sm sm:text-base px-7 py-4 rounded-2xl shadow-sm backdrop-blur-xs transition-all">
            <i class="fa-solid fa-handshake text-brand-fresh"></i>
            <span>Ajukan Kemitraan B2B</span>
          </button>
        </div>

        <!-- Ringkasan Cepat Kategori Produk -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-brand-forest">
          <span class="bg-white/95 backdrop-blur-xs px-3.5 py-1.5 rounded-full border border-brand-sageBorder shadow-2xs">
            <i class="fa-solid fa-check text-brand-fresh mr-1.5"></i>4 Varian Sayuran Segar Premium
          </span>
          <span class="bg-white/95 backdrop-blur-xs px-3.5 py-1.5 rounded-full border border-brand-sageBorder shadow-2xs">
            <i class="fa-solid fa-check text-brand-fresh mr-1.5"></i>3 Varian Paket Siap Masak (250 g)
          </span>
          <span class="bg-white/95 backdrop-blur-xs px-3.5 py-1.5 rounded-full border border-brand-sageBorder shadow-2xs">
            <i class="fa-solid fa-check text-brand-fresh mr-1.5"></i>Harga Resmi Transparan per pcs
          </span>
        </div>
      </div>

      <!-- 4 Pilar Keunggulan Utama -->
      <div id="keunggulan" class="mt-14 pt-10 border-t border-brand-sageBorder/90 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white/95 backdrop-blur-xs hover:bg-brand-sage/90 transition-colors rounded-2xl p-5 border border-brand-sageBorder shadow-xs flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-sage text-brand-dark border border-brand-sageBorder flex items-center justify-center shrink-0">
            <i class="fa-solid fa-seedling text-xl text-brand-fresh"></i>
          </div>
          <div>
            <h2 class="font-display font-bold text-sm text-brand-dark">Sayuran Premium</h2>
            <p class="text-xs text-gray-600 mt-0.5">100% Segar & Terpilih</p>
          </div>
        </div>

        <div class="bg-white/95 backdrop-blur-xs hover:bg-brand-sage/90 transition-colors rounded-2xl p-5 border border-brand-sageBorder shadow-xs flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-sage text-brand-dark border border-brand-sageBorder flex items-center justify-center shrink-0">
            <i class="fa-solid fa-shield-halved text-xl text-brand-fresh"></i>
          </div>
          <div>
            <h2 class="font-display font-bold text-sm text-brand-dark">Higienis & Berkualitas</h2>
            <p class="text-xs text-gray-600 mt-0.5">Sortasi & Kemasan Rapi</p>
          </div>
        </div>

        <div class="bg-white/95 backdrop-blur-xs hover:bg-brand-sage/90 transition-colors rounded-2xl p-5 border border-brand-sageBorder shadow-xs flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-sage text-brand-dark border border-brand-sageBorder flex items-center justify-center shrink-0">
            <i class="fa-solid fa-snowflake text-xl text-brand-fresh"></i>
          </div>
          <div>
            <h2 class="font-display font-bold text-sm text-brand-dark">Rantai Dingin</h2>
            <p class="text-xs text-gray-600 mt-0.5">Sistem Cold Chain Terjaga</p>
          </div>
        </div>

        <div class="bg-white/95 backdrop-blur-xs hover:bg-brand-sage/90 transition-colors rounded-2xl p-5 border border-brand-sageBorder shadow-xs flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-sage text-brand-dark border border-brand-sageBorder flex items-center justify-center shrink-0">
            <i class="fa-solid fa-truck-fast text-xl text-brand-fresh"></i>
          </div>
          <div>
            <h2 class="font-display font-bold text-sm text-brand-dark">Distribusi Efisien</h2>
            <p class="text-xs text-gray-600 mt-0.5">& Pengiriman Tepat Waktu</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. KATALOG PRODUK KAMI ==================== -->
  <section id="produk" class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-fresh bg-brand-sage px-3.5 py-1.5 rounded-full border border-brand-sageBorder mb-3">
          Katalog Produk Resmi
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-brand-dark tracking-tight">
          Produk Segar & Siap Masak SSS
        </h2>
        <p class="text-gray-600 mt-3 text-sm sm:text-base">
          Pilih sayuran segar pilihan dan paket siap masak praktis dalam kemasan higienis bersegel resmi <strong>PT Sayur Seger Sejahtera</strong>.
        </p>
      </div>

      <!-- Control Bar: Filter Kategori, Pencarian Instan & Sinkronisasi Foto Kemasan 12_2.jpg -->
      <div class="bg-brand-sage rounded-3xl p-4 sm:p-6 border border-brand-sageBorder mb-10 space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-forest block">Filter Kategori Produk:</span>
            <p class="text-xs text-gray-500 mt-0.5">Harga jual resmi per satuan <strong>pcs</strong> sesuai kemasan masing-masing produk.</p>
          </div>
          <div id="category-tabs" class="flex flex-wrap gap-2">
            <button type="button" data-cat="all" onclick="setCategory('all')" class="cat-btn px-4 py-2 rounded-full text-xs sm:text-sm font-bold bg-brand-fresh text-white shadow-xs transition-all">
              Semua Produk (7)
            </button>
            <button type="button" data-cat="segar" onclick="setCategory('segar')" class="cat-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-white text-gray-700 border border-brand-sageBorder hover:bg-white/80 transition-all">
              Sayuran Segar Premium (4)
            </button>
            <button type="button" data-cat="siap-masak" onclick="setCategory('siap-masak')" class="cat-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-white text-gray-700 border border-brand-sageBorder hover:bg-white/80 transition-all">
              Paket Siap Masak (3)
            </button>
          </div>
        </div>

        <!-- Bar Pencarian Instan & Tombol Muat Gambar Kemasan 12_2.jpg -->
        <div class="pt-3.5 border-t border-brand-sageBorder/80 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <div class="relative flex-1 max-w-md">
            <i class="fa-solid fa-magnifying-glass text-gray-400 text-xs absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input
              type="text"
              id="product-search-input"
              oninput="handleSearch(this.value)"
              placeholder="Cari produk atau komposisi (misal: brokoli, jagung manis, sayur asem)..."
              class="w-full pl-9 pr-8 py-2.5 rounded-xl bg-white border border-brand-sageBorder text-xs sm:text-sm text-gray-700 focus:outline-none focus:border-brand-fresh"
            />
            <button
              type="button"
              id="clear-search-btn"
              onclick="clearSearch()"
              class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-xs p-1"
              aria-label="Hapus pencarian"
            >
              <i class="fa-solid fa-circle-xmark"></i>
            </button>
          </div>

          <!-- Tombol Sinkronisasi Foto Kemasan 12_2.jpg -->
          <div class="flex flex-wrap items-center gap-2.5">
            <span id="crop-status-badge" class="text-[11px] font-medium text-brand-forest bg-white px-3 py-2 rounded-xl border border-brand-sageBorder flex items-center gap-1.5">
              <i class="fa-solid fa-image text-brand-fresh"></i>
              <span>Tampilan Kemasan SSS Aktif</span>
            </span>
            <input type="file" id="manual-display-input" accept="image/*" class="hidden" onchange="handleManualDisplayUpload(event)" />
            <button
              type="button"
              onclick="document.getElementById('manual-display-input').click()"
              class="inline-flex items-center justify-center gap-2 bg-white hover:bg-brand-dark text-brand-dark hover:text-white border border-brand-sageBorder font-semibold text-xs px-3.5 py-2.5 rounded-xl shadow-2xs transition-colors"
              title="Pilih file 12_2.jpg untuk memotong foto kemasan produk secara otomatis ke katalog"
            >
              <i class="fa-solid fa-crop-simple"></i>
              <span>Muat Ulang / Pilih Gambar 12_2.jpg</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Product Grid Container (7 Kartu Produk Individual) -->
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <!-- Kartu produk dirender via JavaScript -->
      </div>
    </div>
  </section>

  <!-- ==================== 4. SOLUSI KEMITRAAN & TARGET PASAR ==================== -->
  <section id="kemitraan" class="py-16 lg:py-24 bg-brand-sage/60 border-y border-brand-sageBorder relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-fresh bg-white px-3.5 py-1.5 rounded-full border border-brand-sageBorder mb-3">
          Solusi Pasokan B2B & B2C
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-brand-dark tracking-tight">
          Segmen Layanan & Kemitraan SSS
        </h2>
        <p class="text-gray-600 mt-3 text-sm sm:text-base">
          Kami merancang rantai pasok yang fleksibel sesuai volume kebutuhan, frekuensi pengiriman, serta standar kualitas masing-masing mitra di Bandung Raya & Jabodetabek.
        </p>
      </div>

      <!-- 4 Kartu Segmen Layanan -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Segmen 1: B2B Volume Tinggi -->
        <div class="bg-white rounded-2xl p-6 border border-brand-sageBorder shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-5">
              <div class="w-12 h-12 rounded-2xl bg-brand-dark text-white flex items-center justify-center shadow-xs">
                <i class="fa-solid fa-building text-xl"></i>
              </div>
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-dark text-white">
                Prioritas Utama
              </span>
            </div>
            <h3 class="font-display font-bold text-lg text-brand-dark mb-2">B2B Volume Tinggi</h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              Katering korporasi/institusi, distributor bahan pangan, jaringan retail, dan dapur produksi skala besar.
            </p>
          </div>
          <div class="pt-4 border-t border-gray-100 space-y-2.5 text-xs">
            <div class="flex items-center gap-2 text-brand-forest font-semibold">
              <i class="fa-solid fa-box text-brand-fresh"></i>
              <span>100 – 3.000 kg / transaksi</span>
            </div>
            <div class="flex items-center gap-2 text-gray-600">
              <i class="fa-solid fa-check-circle text-brand-fresh"></i>
              <span>Harga stabil & konsistensi pasokan</span>
            </div>
            <button type="button" onclick="openPartnershipModal('B2B Volume Tinggi (100 - 3.000 kg)')" class="mt-2 w-full py-2.5 px-3 rounded-xl bg-brand-sage hover:bg-brand-dark text-brand-dark hover:text-white font-bold transition-colors">
              Ajukan Kerja Sama →
            </button>
          </div>
        </div>

